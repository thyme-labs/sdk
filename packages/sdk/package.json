{
	"name": "@thyme-labs/sdk",
	"version": "0.6.0",
	"description": "SDK for authoring Web3 automation tasks",
	"repository": {
		"type": "git",
		"url": "https://github.com/thyme-labs/sdk.git",
		"directory": "packages/sdk"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./archive-reader": {
			"types": "./dist/archive-reader.d.ts",
			"import": "./dist/archive-reader.js"
		},
		"./lifecycle": {
			"types": "./dist/lifecycle.d.ts",
			"import": "./dist/lifecycle.js"
		},
		"./schema-extractor": {
			"types": "./dist/schema-extractor.d.ts",
			"import": "./dist/schema-extractor.js"
		},
		"./task-runtime": {
			"types": "./dist/task-runtime.d.ts",
			"import": "./dist/task-runtime.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "bun test"
	},
	"keywords": [
		"web3",
		"automation",
		"ethereum",
		"tasks",
		"thyme"
	],
	"author": "",
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"dependencies": {
		"fflate": "^0.8.2",
		"viem": "2.46.3",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"tsup": "^8.3.5",
		"typescript": "^5.7.2"
	}
}
